     "rawQuery": true,
     "editorMode": "code",
     "format": "table",
     "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM first_response_at - created_at)) AS value FROM tickets WHERE first_response_at IS NOT NULL AND $__timeFilter(created_at)"
