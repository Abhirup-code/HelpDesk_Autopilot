    {
      "id": 3,
      "type": "stat",
      "title": "Breaching SLA now",
      "description": "Open tickets past their due time. Waiting-for-manager time is not counted.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "helpdesk-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "helpdesk-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM tickets WHERE status NOT IN ('resolved','auto_resolved','rejected') AND coalesce(paused_at, now()) > due_at"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 8,
