    {
      "id": 9,
      "type": "timeseries",
      "title": "Tickets created per day, by type",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "helpdesk-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "helpdesk-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d'), type AS metric, count(*) AS value FROM tickets WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
