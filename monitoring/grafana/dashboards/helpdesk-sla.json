    {
      "id": 5,
      "type": "stat",
      "title": "SLA compliance",
      "description": "Share of tickets resolved on time in the selected period. Target: 90%.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "helpdesk-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "helpdesk-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * avg(CASE WHEN resolved_at <= due_at THEN 1 ELSE 0 END) AS value FROM tickets WHERE status IN ('resolved','auto_resolved') AND $__timeFilter(resolved_at)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Auto-resolved",
      "description": "Share of resolved tickets that needed no one in IT. BRD target: 50%.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "helpdesk-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "helpdesk-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 100.0 * avg(CASE WHEN status = 'auto_resolved' THEN 1 ELSE 0 END) AS value FROM tickets WHERE status IN ('resolved','auto_resolved') AND $__timeFilter(resolved_at)"
        }
      ],
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 5
