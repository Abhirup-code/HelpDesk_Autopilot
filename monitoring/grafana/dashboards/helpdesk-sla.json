    {
      "id": 12,
      "type": "bargauge",
      "title": "Median time to resolve, by type",
      "description": "Automated types finish in seconds. Access requests include time waiting for a manager. Offboarding is counted from the end of the last day.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "helpdesk-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "helpdesk-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT type AS \"Ticket type\", percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM resolved_at - CASE WHEN type = 'offboarding' THEN greatest(created_at, ((details->>'last_day')::date + 1)::timestamp AT TIME ZONE 'UTC') ELSE created_at END)) AS \"Median\" FROM tickets WHERE status IN ('resolved','auto_resolved') AND $__timeFilter(resolved_at) GROUP BY type ORDER BY 2 DESC"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": "/Median/"
        }
      }
    },
