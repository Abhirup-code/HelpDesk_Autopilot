    {
      "id": 10,
      "type": "timeseries",
      "title": "SLA compliance per day",
      "description": "The red band is below the 90% target.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "helpdesk-db"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "helpdesk-db"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(resolved_at, '1d'), 100.0 * avg(CASE WHEN resolved_at <= due_at THEN 1 ELSE 0 END) AS \"SLA compliance\" FROM tickets WHERE status IN ('resolved','auto_resolved') AND $__timeFilter(resolved_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
