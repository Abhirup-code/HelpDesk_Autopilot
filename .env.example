# Copy to .env for local development. Never commit .env.
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=helpdesk

# Directory (OpenLDAP). The admin account is only used to build the directory;
# the app signs in with the limited autopilot service account.
LDAP_ADMIN_PASSWORD=change-me-ldap-admin
LDAP_SERVICE_PASSWORD=change-me-ldap-service

# Monitoring. Grafana signs in to the database with a read-only login.
GRAFANA_DB_PASSWORD=change-me-grafana-reader
GRAFANA_ADMIN_PASSWORD=change-me-grafana-admin

# Signs portal session cookies. Use a long random value, e.g. `openssl rand -hex 32`.
PORTAL_SECRET_KEY=change-me-to-a-long-random-value
